# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/dbname"
# Or use individual connection parameters
PGUSER=username
PGPASSWORD=password
PGHOST=localhost
PGPORT=5432
PGDATABASE=dbname

# API Security
ADMIN_PASSWORD=change_me_in_production
ENVIRONMENT=development  # Set to 'production' for production deployments

# CORS Configuration
ALLOWED_ORIGINS=*  # Comma-separated list, use specific domains in production

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Service Configuration
PORT=8000  # API Port
FLASK_PORT=5000  # Flask compatibility layer port

# External APIs
OPENAI_API_KEY=your_openai_api_key_here  # Required for AI-powered interpretations