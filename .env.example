# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/dbname"
# Or use individual connection parameters
PGUSER=username
PGPASSWORD=password
PGHOST=localhost
PGPORT=5432
PGDATABASE=dbname

# API Security
ADMIN_PASSWORD=change_me_in_production
ENVIRONMENT=development  # Set to 'production' for production deployments
SESSION_SECRET=change_me_to_a_random_secure_string  # Required for Flask session encryption

# API Configuration
DEFAULT_API_KEY=api_key_for_internal_communication
API_BASE_URL=/api  # For Replit deployment, set to /api instead of http://localhost:8000

# CORS Configuration
ALLOWED_ORIGINS=*  # Comma-separated list, use specific domains in production

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Service Configuration
PORT=8000  # API Port
FLASK_PORT=5000  # Flask compatibility layer port

# External APIs
OPENAI_API_KEY=your_openai_api_key_here  # Required for AI-powered interpretations

# Redis Caching Configuration
REDIS_URL=redis://localhost:6379/0  # Redis connection URL
REDIS_CACHE_TTL=604800  # Default cache expiration time in seconds (7 days)

# Replit Specific Configuration
# These are optional for local development but should be set on Replit
REPLIT_DB_URL=  # Automatically set by Replit
REPL_ID=        # Automatically set by Replit
REPL_OWNER=     # Automatically set by Replit